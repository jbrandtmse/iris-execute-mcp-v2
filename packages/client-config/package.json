{
  "name": "@iris-mcp/client-config",
  "version": "0.0.1",
  "description": "Multi-client MCP configuration manager for the iris-mcp suite — declarative ClientAdapter registry, detection, native-format readers, status matrix, and pure diff renderer (read-only foundation; writes arrive in Epic 33 Story 33.1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris-mcp-clients": "./dist/cli/clients-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
