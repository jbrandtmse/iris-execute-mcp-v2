{
  "name": "@iris-mcp/client-config",
  "version": "0.0.1",
  "description": "Client configuration manager and skills-pack installer for the IRIS MCP servers: detects MCP clients, writes and removes server entries with backups, and installs the skills pack into a project",
  "keywords": [
    "iris",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "configuration",
    "agent-skills",
    "ai-agents"
  ],
  "homepage": "https://github.com/jbrandtmse/iris-execute-mcp-v2/tree/main/packages/client-config#readme",
  "bugs": {
    "url": "https://github.com/jbrandtmse/iris-execute-mcp-v2/issues"
  },
  "license": "MIT",
  "author": "jbrandtmse (https://github.com/jbrandtmse)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbrandtmse/iris-execute-mcp-v2.git",
    "directory": "packages/client-config"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris-mcp-clients": "./dist/cli/clients-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "skills-pack"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/verify-iris-reachable.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0"
  }
}
