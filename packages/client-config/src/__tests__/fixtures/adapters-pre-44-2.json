{
  "captureCommand": "node capture-oracle.mjs <repo-root> <out-dir> against the dist built from the pre-edit tree (baseline commit 9f7797c5)",
  "adapters": {
    "claude-code": {
      "id": "claude-code",
      "displayName": "Claude Code",
      "format": "json",
      "rootKey": "mcpServers",
      "scopes": [
        {
          "scope": "user",
          "paths": {
            "win32": "~/.claude.json",
            "darwin": "~/.claude.json",
            "linux": "~/.claude.json"
          },
          "envOverride": {
            "var": "CLAUDE_CONFIG_DIR",
            "pathSuffix": ".claude.json"
          },
          "shareable": false
        },
        {
          "scope": "project",
          "paths": {
            "win32": ".mcp.json",
            "darwin": ".mcp.json",
            "linux": ".mcp.json"
          },
          "shareable": true
        }
      ],
      "entryShape": "standard",
      "envExpansion": "claude",
      "disableSupport": "stash",
      "restartHint": "Restart Claude Code (or start a new session) for MCP changes to take effect.",
      "detection": [
        {
          "kind": "config",
          "scope": "user"
        },
        {
          "kind": "config",
          "scope": "project"
        },
        {
          "kind": "appDir",
          "paths": {
            "win32": "~/.claude",
            "darwin": "~/.claude",
            "linux": "~/.claude"
          }
        }
      ],
      "docsUrl": "https://code.claude.com/docs/en/mcp"
    },
