  "dispositions": [
    {
      "id": "kilo-code",
      "displayName": "Kilo Code",
      "disposition": "roadmap",
      "reason": "Documents MCP (~/.config/kilo/kilo.json[c] or ./kilo.json[c] or ./.kilo/kilo.jsonc, top-level `mcp` key), but its entries use an OpenCode-style shape (type \"local\", `command` as an array, `environment`, `enabled`) that the engine does not model yet; supporting it needs a new entry shape, not an adapter-data patch."
    },
    {
      "id": "antigravity",
      "displayName": "Antigravity CLI",
      "disposition": "roadmap",
      "reason": "Documents MCP at ~/.gemini/config/mcp_config.json and .agents/mcp_config.json, but detection would collide with Gemini CLI's ~/.gemini, and no Windows path is documented; verify both before adding an adapter."
    }
  ]
}
