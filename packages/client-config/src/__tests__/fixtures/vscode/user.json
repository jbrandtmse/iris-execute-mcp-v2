{
  "mcpServers": {
    "iris-dev-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@iris-mcp/dev@1"],
      "env": {
        "IRIS_PASSWORD": "${IRIS_PASSWORD}"
      },
      "tools": ["*"]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ghp_foreignSecretValue123"
      },
      "tools": ["*"]
    }
  }
}
