{
  "name": "@iris-mcp/shared",
  "version": "0.0.2",
  "description": "Shared framework for the IRIS MCP servers: configuration, governance, audit and the IRIS gateway, plus the iris-mcp-credentials and iris-mcp-governance commands",
  "keywords": [
    "iris",
    "mcp",
    "model-context-protocol",
    "framework",
    "governance",
    "audit",
    "ai-agents"
  ],
  "homepage": "https://github.com/jbrandtmse/iris-execute-mcp-v2/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/jbrandtmse/iris-execute-mcp-v2/issues"
  },
  "license": "MIT",
  "author": "jbrandtmse (https://github.com/jbrandtmse)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbrandtmse/iris-execute-mcp-v2.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris-mcp-credentials": "./dist/cli/credentials-cli.js",
    "iris-mcp-governance": "./dist/cli/governance-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-helpers": {
      "types": "./src/__tests__/test-helpers.ts",
      "import": "./src/__tests__/test-helpers.ts"
    },
    "./test-helpers/integration-config": {
      "types": "./src/test-helpers/integration-config.ts",
      "import": "./src/test-helpers/integration-config.ts"
    },
    "./test-helpers/live-target": {
      "types": "./src/test-helpers/live-target.ts",
      "import": "./src/test-helpers/live-target.ts"
    },
    "./test-helpers/storage-guard-fixtures": {
      "types": "./src/__tests__/storage-guard-fixtures.ts",
      "import": "./src/__tests__/storage-guard-fixtures.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/test-helpers",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/ --max-warnings 0",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/verify-iris-reachable.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.17.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
