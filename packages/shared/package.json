{
  "name": "@iris-mcp/shared",
  "version": "0.0.2",
  "description": "Shared utilities and types for IRIS MCP servers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris-mcp-credentials": "./dist/cli/credentials-cli.js",
    "iris-mcp-governance": "./dist/cli/governance-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-helpers": {
      "types": "./src/__tests__/test-helpers.ts",
      "import": "./src/__tests__/test-helpers.ts"
    },
    "./test-helpers/integration-config": {
      "types": "./src/test-helpers/integration-config.ts",
      "import": "./src/test-helpers/integration-config.ts"
    },
    "./test-helpers/storage-guard-fixtures": {
      "types": "./src/__tests__/storage-guard-fixtures.ts",
      "import": "./src/__tests__/storage-guard-fixtures.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/verify-iris-reachable.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^25.5.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
