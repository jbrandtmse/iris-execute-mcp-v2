{
  "name": "@iris-mcp/admin",
  "version": "0.0.2",
  "description": "IRIS Administration MCP Server",
  "keywords": [
    "iris",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "administration",
    "security",
    "ai-agents"
  ],
  "homepage": "https://github.com/jbrandtmse/iris-execute-mcp-v2/tree/main/packages/iris-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/jbrandtmse/iris-execute-mcp-v2/issues"
  },
  "license": "MIT",
  "author": "jbrandtmse (https://github.com/jbrandtmse)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbrandtmse/iris-execute-mcp-v2.git",
    "directory": "packages/iris-admin-mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "iris-admin-mcp": "./dist/index.js"
  },
  "mcpName": "io.github.jbrandtmse/iris-admin-mcp",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/verify-iris-reachable.mjs && node scripts/prepublish-gate.mjs"
  },
  "dependencies": {
    "@iris-mcp/shared": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.17.0"
  }
}
