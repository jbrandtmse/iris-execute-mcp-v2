# Dependencies
node_modules/
package-lock.json
# extensions/iris-mcp-launcher is npm-managed and outside the pnpm workspace
# (pnpm-workspace.yaml globs only packages/*) — its lockfile IS committed for
# reproducible installs of that standalone extension.
!extensions/iris-mcp-launcher/package-lock.json

# Build output
dist/
out/
*.tsbuildinfo
*.vsix

# Environment
.env
.env.local

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# Coverage
coverage/
# ...but not the IRIS class package ExecuteMCPv2.Coverage (Story 40.1): `coverage/` also matches `Coverage/` where
# the file system ignores case, and these classes are source.
!src/ExecuteMCPv2/Coverage/

# Existing exclusions
sources/
irislib/
irissys/
.claude/scratch/

# Code-review diff snapshots (bmad-code-review step-01 frozen-diff artifact)
_bmad-output/implementation-artifacts/review-diff-snapshot-*.diff

# BMAD installer backups of the previous install (content is in git history)
_bmad/**/*.bak

# /epic-cycle kit backups (<file>.bak-<UTC>; the originals are in git history)
*.bak-[0-9]*
