+    expect(seen?.command).toBe("npx");
+    expect(seen?.args).toEqual([
+      "-y", "-p", "@iris-mcp/shared", "iris-mcp-governance",
+      "set", "iris_doc_put", "false", "--file", "/p/g.json", "--profile", "prod",
+    ]);
+  });
