+describe("fileValueFor / toggleFor / stageToggle", () => {
+  it("reads the file's OWN value per tab layer from the diff entries", () => {
+    const state = makeState();
+    expect(fileValueFor(state, GLOBAL_TAB, "iris_doc_put")).toBe(false);
