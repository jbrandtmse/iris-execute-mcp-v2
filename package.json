{
  "name": "iris-mcp-suite",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo of Model Context Protocol servers for IRIS: five stdio servers, their shared framework, a client configuration manager and a skills pack",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:bootstrap": "node scripts/gen-bootstrap.mjs",
    "gen:ipm": "node scripts/gen-bootstrap.mjs --ipm",
    "gen:ipm:check": "node scripts/gen-bootstrap.mjs --ipm-check",
    "pregen:governance-baseline": "turbo run build --filter @iris-mcp/shared",
    "gen:governance-baseline": "node scripts/gen-governance-baseline.mjs",
    "pregen:governance-baseline:check": "turbo run build --filter @iris-mcp/shared",
    "gen:governance-baseline:check": "node scripts/gen-governance-baseline.mjs --check",
    "gen:skills": "node scripts/gen-skills.mjs",
    "gen:skills:check": "node scripts/gen-skills.mjs --check",
    "gen:pack": "node scripts/gen-pack.mjs",
    "gen:pack:check": "node scripts/gen-pack.mjs --check",
    "gen:listings": "node scripts/gen-listings.mjs",
    "gen:listings:check": "node scripts/gen-listings.mjs --check",
    "check:live-guards": "node scripts/check-live-guards.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "validate:prompts": "node scripts/validate-prompts.mjs",
    "live:bootstrap-guard": "node scripts/throwaway-iris.mjs run -- pnpm --filter @iris-mcp/all exec vitest run src/__tests__/story-42-2-bootstrap-guard-live-gate.test.ts",
    "live:uninstall-round-trip": "sh -c 'S=\"$(mktemp -d)/uninstall.json\"; node scripts/throwaway-iris.mjs up --image intersystems/irishealth-community:2026.2@sha256:462de1fb3597272fde0e03afad006af1b18b59c90f1c1fb5566c79b027a7af0a --namespace USER --host-port 52792 --state \"$S\" && { THROWAWAY_STATE_FILE=\"$S\" node scripts/throwaway-iris.mjs exec --state \"$S\" -- pnpm --filter @iris-mcp/all exec vitest run src/__tests__/story-45-3-uninstall-round-trip-live-gate.test.ts; R=$?; node scripts/throwaway-iris.mjs down --state \"$S\"; exit $R; }'",
    "measure:tools-payload": "node scripts/measure-tools-payload.mjs",
    "gen:tools-list-snapshot": "node scripts/gen-tools-list-snapshot.mjs",
    "gen:tools-list-snapshot:check": "node scripts/gen-tools-list-snapshot.mjs --check",
    "changeset": "changeset",
    "version": "node scripts/release-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.17.0"
  }
}
